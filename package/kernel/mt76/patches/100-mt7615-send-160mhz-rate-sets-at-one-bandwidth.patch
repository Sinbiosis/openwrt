+
+	if (same_bw && probe_rate)
+		mt7615_mac_rate_set_bw(ref, bw_flags);
+
 	for (i = 0; i < ARRAY_SIZE(sta->rateset[rateset].rates); i++) {
+		if (same_bw)
+			mt7615_mac_rate_set_bw(&rates[i], bw_flags);
+
 		/*
 		 * We don't support switching between short and long GI
 		 * within the rate set. For accurate tx status reporting, we
@@ -1003,6 +1110,11 @@
 			     IEEE80211_TX_RC_160_MHZ_WIDTH))
 				continue;
 
+			if (same_bw) {
+				mt7615_mac_rate_dec_mcs(&rates[i], bw_flags);
+				continue;
+			}
+
 			if (!rates[i].idx)
 				continue;
 
@@ -1014,7 +1126,7 @@
 	bw_prev = bw;
 
 	if (probe_rate) {
-		rd->probe_val = mt7615_mac_tx_rate_val(dev, mphy, probe_rate,
+		rd->probe_val = mt7615_mac_tx_rate_val(dev, mphy, ref,
 						       stbc, &bw);
 		if (bw)
 			rd->bw_idx = 1;
@@ -1041,7 +1153,7 @@
