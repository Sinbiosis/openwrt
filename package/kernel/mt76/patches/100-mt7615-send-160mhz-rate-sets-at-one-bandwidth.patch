 	int i, j;
 
 	for (i = n_rates; i < 4; i++)
@@ -983,7 +1066,31 @@
 	}
 
 	rates = sta->rateset[rateset].rates;
+
+	/*
+	 * The hardware sends all rates of a set at one bandwidth. Normally
+	 * that is the one of the last rate, which can put a 160 MHz rate on
+	 * the air at 80 MHz, or a rate that only exists at 80 MHz or less on
+	 * the air at 160 MHz where it is lost without any tx status.
+	 * If the set has a 160 MHz rate, use the bandwidth of the reference
+	 * rate (the probe rate or the first rate) for all of it and make every
+	 * VHT rate valid there. As the stored set is changed as well, tx status
+	 * reports the bandwidth that was used.
+	 */
+	bw_flags = ref->flags & MT7615_TX_RC_BW_MASK;
+	if (probe_rate && (ref->flags & IEEE80211_TX_RC_160_MHZ_WIDTH))
+		same_bw = true;
+	for (i = 0; i < ARRAY_SIZE(sta->rateset[rateset].rates); i++)
+		if (rates[i].flags & IEEE80211_TX_RC_160_MHZ_WIDTH)
