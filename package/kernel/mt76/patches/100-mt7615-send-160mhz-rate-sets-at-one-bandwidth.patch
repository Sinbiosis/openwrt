--- a/mt7615/mac.c
+++ b/mt7615/mac.c
@@ -954,6 +954,88 @@
 }
 EXPORT_SYMBOL_GPL(mt7615_mac_sta_poll);
 
+#define MT7615_TX_RC_BW_MASK	(IEEE80211_TX_RC_40_MHZ_WIDTH |	\
+				 IEEE80211_TX_RC_80_MHZ_WIDTH |	\
+				 IEEE80211_TX_RC_160_MHZ_WIDTH)
+
+/* bandwidth value of a rate set, see mt7615_mac_tx_rate_val() */
+static u8 mt7615_mac_rate_bw(u32 bw_flags)
+{
+	if (bw_flags & IEEE80211_TX_RC_160_MHZ_WIDTH)
+		return 3;
+	if (bw_flags & IEEE80211_TX_RC_80_MHZ_WIDTH)
+		return 2;
+	if (bw_flags & IEEE80211_TX_RC_40_MHZ_WIDTH)
+		return 1;
+
+	return 0;
+}
+
+/* some VHT MCS do not exist for every bandwidth and number of streams */
+static bool mt7615_vht_mcs_valid(u32 bw_flags, int nss, int mcs)
+{
+	if (mcs == 9) {
+		if (bw_flags & IEEE80211_TX_RC_160_MHZ_WIDTH)
+			return nss != 3;
+		if (bw_flags & IEEE80211_TX_RC_80_MHZ_WIDTH)
+			return nss != 6;
+		if (!(bw_flags & IEEE80211_TX_RC_40_MHZ_WIDTH))
+			return nss == 3 || nss == 6;
+	} else if (mcs == 6 && (bw_flags & IEEE80211_TX_RC_80_MHZ_WIDTH)) {
+		return nss != 3 && nss != 7;
+	}
+
+	return true;
+}
+
+/* make a VHT rate valid at the bandwidth its whole rate set is sent at */
+static void
+mt7615_mac_rate_set_bw(struct ieee80211_tx_rate *rate, u32 bw_flags)
+{
+	int nss, mcs;
+
+	if (!(rate->flags & IEEE80211_TX_RC_VHT_MCS))
+		return;
+
+	rate->flags = (rate->flags & ~MT7615_TX_RC_BW_MASK) | bw_flags;
+
+	nss = ieee80211_rate_get_vht_nss(rate);
+	mcs = ieee80211_rate_get_vht_mcs(rate);
+
+	if ((bw_flags & IEEE80211_TX_RC_160_MHZ_WIDTH) &&
+	    nss > MT7615_MAX_NSS_160)
+		nss = MT7615_MAX_NSS_160;
+
+	while (mcs && !mt7615_vht_mcs_valid(bw_flags, nss, mcs))
+		mcs--;
+
+	ieee80211_rate_set_vht(rate, mcs, nss);
+}
+
+/* step a rate down to the next lower MCS that exists, MCS 0 stays */
+static void
+mt7615_mac_rate_dec_mcs(struct ieee80211_tx_rate *rate, u32 bw_flags)
+{
+	int nss, mcs;
+
+	if (!(rate->flags & IEEE80211_TX_RC_VHT_MCS)) {
+		if (rate->idx)
+			rate->idx--;
+		return;
+	}
+
+	nss = ieee80211_rate_get_vht_nss(rate);
+	mcs = ieee80211_rate_get_vht_mcs(rate);
+	if (!mcs)
+		return;
+
+	mcs--;
+	while (mcs && !mt7615_vht_mcs_valid(bw_flags, nss, mcs))
+		mcs--;
+
+	ieee80211_rate_set_vht(rate, mcs, nss);
+}
+
