+/* a rate value with the stream count it really has, i.e. without STBC */
+static u16 mt7615_txs_rate_norm(u16 val)
+{
+	u16 nss = FIELD_GET(MT_TX_RATE_NSS, val);
+
+	if ((val & MT_TX_RATE_STBC) && nss)
+		nss--;
+
+	return (val & (MT_TX_RATE_MODE | MT_TX_RATE_IDX)) |
+	       FIELD_PREP(MT_TX_RATE_NSS, nss);
+}
+
+/* rate value that mt7615_mac_set_rates() put into hardware rate slot @slot */
+static u16 mt7615_txs_slot_val(struct mt7615_dev *dev, struct mt76_phy *mphy,
+			       struct mt7615_rate_set *rs, int slot)
+{
+	struct ieee80211_tx_rate *rate = &rs->rates[slot / 2];
+	u8 bw;
+
+	if (!slot && rs->probe_rate.idx >= 0)
+		rate = &rs->probe_rate;
+
+	return mt7615_txs_rate_norm(mt7615_mac_tx_rate_val(dev, mphy, rate,
+							   false, &bw));
+}
+
+static void mt7615_txs_stats_flags(struct mt7615_dev *dev, __le32 *txs_data)
+{
+	struct mt7615_txs_stats *st = &dev->txs_stats;
+	u32 txs0 = le32_to_cpu(txs_data[0]);
+	u32 txs1 = le32_to_cpu(txs_data[1]);
+	u32 txs3 = le32_to_cpu(txs_data[3]);
+	int count = FIELD_GET(MT_TXS3_TX_COUNT, txs3);
+
+	st->total++;
+	st->tx_count[count]++;
+	st->last_idx[FIELD_GET(MT_TXS3_LAST_TX_RATE, txs3)]++;
+	if (!count)
+		st->no_tx++;
+	if (txs0 & MT_TXS0_FIXED_RATE)
+		st->fixed_rate++;
+	if (txs1 & MT_TXS1_AMPDU)
+		st->ampdu++;
+	if (txs0 & MT_TXS0_ACK_TIMEOUT)
+		st->ack_timeout++;
+	if (txs0 & MT_TXS0_RTS_TIMEOUT)
+		st->rts_timeout++;
+	if (txs0 & MT_TXS0_QUEUE_TIMEOUT)
+		st->queue_timeout++;
+	if (txs0 & MT_TXS0_BA_ERROR)
+		st->ba_error++;
+}
+
+/*
+ * How the rate set was chosen for a tx status: the time from the newest
+ * rate set update to the first transmission, which rate set holds the
+ * final rate at the last slot used, and the bandwidth reported in the tx
+ * status for the bandwidth of that rate.
+ */
+static void mt7615_txs_stats_set(struct mt7615_dev *dev,
+				 struct mt7615_sta *sta, __le32 *txs_data,
+				 u32 rate_set_tsf, bool rs_idx, int last_idx,
+				 u32 final_rate)
+{
+	struct mt7615_txs_stats *st = &dev->txs_stats;
+	struct mt76_phy *mphy = &dev->mphy;
+	u16 val = mt7615_txs_rate_norm(final_rate);
+	struct ieee80211_tx_rate *rate;
+	bool chosen, other;
+	s32 age;
+	int i;
+
+	if (sta->wcid.phy_idx && dev->mt76.phys[MT_BAND1])
+		mphy = dev->mt76.phys[MT_BAND1];
+
+	age = le32_get_bits(txs_data[4], MT_TXS4_F0_TIMESTAMP) - rate_set_tsf;
+	if (age < -1000000)
+		i = 0;
+	else if (age < 0)
+		i = 1;
+	else if (age < 1000)
+		i = 2;
+	else if (age < 10000)
+		i = 3;
+	else if (age < 100000)
+		i = 4;
+	else if (age < 1000000)
+		i = 5;
+	else
+		i = 6;
+	st->age[i]++;
+
+	chosen = mt7615_txs_slot_val(dev, mphy, &sta->rateset[rs_idx],
+				     last_idx) == val;
+	other = mt7615_txs_slot_val(dev, mphy, &sta->rateset[!rs_idx],
+				    last_idx) == val;
+	st->set_match[chosen ? (other ? 2 : 0) : (other ? 1 : 3)]++;
+
+	rate = &sta->rateset[rs_idx].rates[last_idx / 2];
+	if (!last_idx && sta->rateset[rs_idx].probe_rate.idx >= 0)
+		rate = &sta->rateset[rs_idx].probe_rate;
+	if (rate->flags & IEEE80211_TX_RC_160_MHZ_WIDTH)
+		i = 3;
+	else if (rate->flags & IEEE80211_TX_RC_80_MHZ_WIDTH)
+		i = 2;
+	else if (rate->flags & IEEE80211_TX_RC_40_MHZ_WIDTH)
+		i = 1;
+	else
+		i = 0;
+	st->bw[i][le32_get_bits(txs_data[1], MT_TXS1_BW)]++;
+}
