 }
 
 static int
+mt7615_txs_stats_read(struct seq_file *s, void *data)
+{
+	struct mt7615_dev *dev = dev_get_drvdata(s->private);
+	struct mt7615_txs_stats *st = &dev->txs_stats;
+	static const char * const age[] = {
+		"<-1s", "-1s..0", "0..1ms", "1..10ms", "10..100ms",
+		"100ms..1s", ">=1s",
+	};
+	static const char * const match[] = {
+		"chosen", "other", "both", "neither",
+	};
+	int i, j;
+
+	seq_printf(s, "total %u fixed_rate %u ampdu %u no_tx %u no_rate_info %u\n",
+		   st->total, st->fixed_rate, st->ampdu, st->no_tx,
+		   st->no_rate_info);
+	seq_printf(s, "ack_timeout %u rts_timeout %u queue_timeout %u ba_error %u\n",
+		   st->ack_timeout, st->rts_timeout, st->queue_timeout,
+		   st->ba_error);
+
+	seq_puts(s, "age:");
+	for (i = 0; i < ARRAY_SIZE(st->age); i++)
+		seq_printf(s, " %s %u", age[i], st->age[i]);
+
+	seq_puts(s, "\nset_match:");
+	for (i = 0; i < ARRAY_SIZE(st->set_match); i++)
+		seq_printf(s, " %s %u", match[i], st->set_match[i]);
+
+	seq_puts(s, "\nbw (rate->txs):");
+	for (i = 0; i < 4; i++)
+		for (j = 0; j < 4; j++)
+			if (st->bw[i][j])
+				seq_printf(s, " %d->%d %u", 20 << i, 20 << j,
+					   st->bw[i][j]);
+
+	seq_puts(s, "\ntx_count:");
+	for (i = 0; i < ARRAY_SIZE(st->tx_count); i++)
+		if (st->tx_count[i])
+			seq_printf(s, " %d:%u", i, st->tx_count[i]);
+
+	seq_puts(s, "\nlast_idx:");
+	for (i = 0; i < ARRAY_SIZE(st->last_idx); i++)
+		seq_printf(s, " %d:%u", i, st->last_idx[i]);
+	seq_puts(s, "\n");
+
+	return 0;
+}
