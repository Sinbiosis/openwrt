wifi: mt76: mt7615: debugfs overrides for the bandwidth change of 160 MHz sets

Testing aid, not for merging. Add two debugfs files that override WTBL
fields of rate sets sent at 160 MHz, on MMIO only:

- bw160_change_bw_rate: the slot from which the hardware changes the
  bandwidth (1-7, CHANGE_BW_RATE)
- bw160_bw_cap: the bandwidth capability (20, 40, 80 or 160 MHz,
  BW_CAP), which the driver otherwise sets to the bandwidth of the set

0, the default, leaves a field as the driver sets it. A new value takes
effect with the next rate set update. This is to find out whether a
smaller BW_CAP turns the tries from CHANGE_BW_RATE on into working
retries at a narrower bandwidth instead of 6 Mbit/s OFDM.

--- a/mt7615/debugfs.c
+++ b/mt7615/debugfs.c
@@ -736,6 +736,9 @@ int mt7615_init_debugfs(struct mt7615_de
 			    &fops_txs_stats_reset);
 	debugfs_create_devm_seqfile(dev->mt76.dev, "txs_fail_log", dir,
 				    mt7615_txs_fail_read);
+	debugfs_create_u32("bw160_change_bw_rate", 0600, dir,
+			   &dev->bw160_change_bw_rate);
+	debugfs_create_u32("bw160_bw_cap", 0600, dir, &dev->bw160_bw_cap);
 
 	if (is_mt7615(&dev->mt76)) {
 		debugfs_create_u32("dfs_hw_pattern", 0400, dir,
--- a/mt7615/mac.c
+++ b/mt7615/mac.c
@@ -1261,6 +1261,32 @@ u32 mt7615_mac_get_sta_tid_sn(struct mt7
 	return val & GENMASK(11, 0);
 }
 
+/*
+ * Test overrides from debugfs for a set sent at 160 MHz: the slot from which
+ * the hardware changes the bandwidth (1-7) and the bandwidth capability
+ * (20, 40, 80 or 160 MHz). 0 leaves a field as it is.
+ */
+static u32 mt7615_mac_bw160_override(struct mt7615_dev *dev, u8 bw, u32 w5)
+{
+	u32 slot = READ_ONCE(dev->bw160_change_bw_rate);
+	u32 cap = READ_ONCE(dev->bw160_bw_cap);
+
+	if (bw != 3)
+		return w5;
+
+	if (slot >= 1 && slot <= 7) {
+		w5 &= ~MT_WTBL_W5_CHANGE_BW_RATE;
+		w5 |= FIELD_PREP(MT_WTBL_W5_CHANGE_BW_RATE, slot);
+	}
+
+	if (cap == 20 || cap == 40 || cap == 80 || cap == 160) {
+		w5 &= ~MT_WTBL_W5_BW_CAP;
+		w5 |= FIELD_PREP(MT_WTBL_W5_BW_CAP, ilog2(cap / 20));
+	}
+
+	return w5;
+}
+
 void mt7615_mac_set_rates(struct mt7615_phy *phy, struct mt7615_sta *sta,
 			  struct ieee80211_tx_rate *probe_rate,
 			  struct ieee80211_tx_rate *rates)
@@ -1298,6 +1324,7 @@ void mt7615_mac_set_rates(struct mt7615_
 	      FIELD_PREP(MT_WTBL_W5_CHANGE_BW_RATE,
 			 rd.bw_idx ? rd.bw_idx - 1 : 7) |
 	      rd.sgi;
+	w5 = mt7615_mac_bw160_override(dev, rd.bw, w5);
 
 	mt76_wr(dev, MT_WTBL_RIUCR0, w5);
 
--- a/mt7615/mt7615.h
+++ b/mt7615/mt7615.h
@@ -315,6 +315,10 @@ struct mt7615_dev {
 
 	struct mt7615_txs_stats txs_stats;
 
+	/* test overrides for rate sets sent at 160 MHz, 0 for none */
+	u32 bw160_change_bw_rate;
+	u32 bw160_bw_cap;
+
 	u32 debugfs_rf_wf;
 	u32 debugfs_rf_reg;
 
