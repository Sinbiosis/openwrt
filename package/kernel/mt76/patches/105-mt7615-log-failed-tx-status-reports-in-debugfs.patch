wifi: mt76: mt7615: log failed tx status reports in debugfs

Add a debugfs file, txs_fail_log, with the last 16 tx status reports
that have an ACK, RTS or queue timeout, to see what a frame that was
never acknowledged was sent with. Each entry has:

- the raw report, and from it the final rate, bandwidth, last rate
  slot, transmission count and status flags
- the time from the newest rate set update to the first transmission,
  and the rate set the report is credited to
- both rate sets of the station, as programmed
- on MMIO, the bandwidth, bandwidth change and guard interval fields
  of the station's WTBL entry, read when the report comes in

Writing to txs_stats_reset clears the log as well. This is a
measurement aid only; nothing else changes.

--- a/mt7615/debugfs.c
+++ b/mt7615/debugfs.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: BSD-3-Clause-Clear
 
 #include "mt7615.h"
+#include "mac.h"
 
 static int
 mt7615_reg_set(void *data, u64 val)
@@ -413,6 +414,103 @@ mt7615_txs_stats_reset(void *data, u64 v
 DEFINE_DEBUGFS_ATTRIBUTE(fops_txs_stats_reset, NULL,
 			 mt7615_txs_stats_reset, "%lld\n");
 
+/* a rate as bandwidth/streams/mcs, "s" for short GI */
+static void
+mt7615_txs_fail_rate(struct seq_file *s, const struct ieee80211_tx_rate *r)
+{
+	static const char * const bw[] = { "20", "40", "80", "160" };
+	const char *gi = r->flags & IEEE80211_TX_RC_SHORT_GI ? "s" : "";
+	int i = 0;
+
+	if (r->flags & IEEE80211_TX_RC_160_MHZ_WIDTH)
+		i = 3;
+	else if (r->flags & IEEE80211_TX_RC_80_MHZ_WIDTH)
+		i = 2;
+	else if (r->flags & IEEE80211_TX_RC_40_MHZ_WIDTH)
+		i = 1;
+
+	if (r->idx < 0)
+		seq_puts(s, " -");
+	else if (r->flags & IEEE80211_TX_RC_VHT_MCS)
+		seq_printf(s, " %s/%d/%d%s", bw[i],
+			   ieee80211_rate_get_vht_nss(r),
+			   ieee80211_rate_get_vht_mcs(r), gi);
+	else if (r->flags & IEEE80211_TX_RC_MCS)
+		seq_printf(s, " ht%s/%d%s", bw[i], r->idx, gi);
+	else
+		seq_printf(s, " legacy%d", r->idx);
+}
+
+static int
+mt7615_txs_fail_read(struct seq_file *s, void *data)
+{
+	struct mt7615_dev *dev = dev_get_drvdata(s->private);
+	struct mt7615_txs_stats *st = &dev->txs_stats;
+	static const char * const mode[] = {
+		[MT_PHY_TYPE_CCK] = "cck",
+		[MT_PHY_TYPE_OFDM] = "ofdm",
+		[MT_PHY_TYPE_HT] = "ht",
+		[MT_PHY_TYPE_HT_GF] = "ht-gf",
+		[MT_PHY_TYPE_VHT] = "vht",
+	};
+	u32 pos = READ_ONCE(st->fail_pos);
+	u32 n = min_t(u32, pos, ARRAY_SIZE(st->fail));
+	int i, j;
+
+	seq_puts(s, "rates: bandwidth/streams/mcs, s = short GI\n");
+	for (i = 0; i < n; i++) {
+		struct mt7615_txs_fail *f;
+		u32 rate, m;
+		s32 age;
+
+		f = &st->fail[(pos - n + i) % ARRAY_SIZE(st->fail)];
+		rate = FIELD_GET(MT_TXS0_TX_RATE, f->txs[0]);
+		m = FIELD_GET(MT_TX_RATE_MODE, rate);
+		age = f->txs[4] - f->rate_set_tsf;
+
+		seq_printf(s, "#%u t=%ums age=%dus newest=set%u chosen=set%u\n",
+			   pos - n + i,
+			   jiffies_to_msecs(f->jiffies - (u32)INITIAL_JIFFIES),
+			   age, f->rate_set_tsf & 1,
+			   (age < 0) ^ (f->rate_set_tsf & 1));
+		seq_printf(s, "  txs %08x %08x %08x %08x %08x\n",
+			   f->txs[0], f->txs[1], f->txs[2], f->txs[3], f->txs[4]);
+		seq_printf(s, "  sent %s %d/%lu/%lu%s slot %lu tries %lu%s%s%s%s%s%s\n",
+			   m < ARRAY_SIZE(mode) && mode[m] ? mode[m] : "?",
+			   20 << FIELD_GET(MT_TXS1_BW, f->txs[1]),
+			   FIELD_GET(MT_TX_RATE_NSS, rate) + 1,
+			   FIELD_GET(MT_TX_RATE_IDX, rate),
+			   rate & MT_TX_RATE_STBC ? " stbc" : "",
+			   FIELD_GET(MT_TXS3_LAST_TX_RATE, f->txs[3]),
+			   FIELD_GET(MT_TXS3_TX_COUNT, f->txs[3]),
+			   f->txs[0] & MT_TXS0_ACK_TIMEOUT ? " ack-timeout" : "",
+			   f->txs[0] & MT_TXS0_RTS_TIMEOUT ? " rts-timeout" : "",
+			   f->txs[0] & MT_TXS0_QUEUE_TIMEOUT ? " queue-timeout" : "",
+			   f->txs[0] & MT_TXS0_BA_ERROR ? " ba-error" : "",
+			   f->txs[0] & MT_TXS0_FIXED_RATE ? " fixed-rate" : "",
+			   f->txs[1] & MT_TXS1_AMPDU ? " ampdu" : "");
+		if (mt76_is_mmio(&dev->mt76))
+			seq_printf(s, "  wtbl bw_cap %d change_bw_rate %lu cc_bw_sel %d sgi %x rate_idx %lu\n",
+				   20 << FIELD_GET(MT_WTBL_W5_BW_CAP, f->w5),
+				   FIELD_GET(MT_WTBL_W5_CHANGE_BW_RATE, f->w5),
+				   20 << FIELD_GET(MT_WTBL_W27_CC_BW_SEL, f->w27),
+				   (f->w5 >> 8) & 0xf,
+				   FIELD_GET(MT_WTBL_W5_RATE_IDX, f->w5));
+		for (j = 0; j < ARRAY_SIZE(f->rateset); j++) {
+			int k;
+
+			seq_printf(s, "  set%d probe", j);
+			mt7615_txs_fail_rate(s, &f->rateset[j].probe_rate);
+			seq_puts(s, " | rates");
+			for (k = 0; k < ARRAY_SIZE(f->rateset[j].rates); k++)
+				mt7615_txs_fail_rate(s, &f->rateset[j].rates[k]);
+			seq_puts(s, "\n");
+		}
+	}
+
+	return 0;
+}
+
 static int
 mt7615_queues_acq(struct seq_file *s, void *data)
 {
@@ -636,6 +734,8 @@ int mt7615_init_debugfs(struct mt7615_de
 				    mt7615_txs_stats_read);
 	debugfs_create_file("txs_stats_reset", 0200, dir, dev,
 			    &fops_txs_stats_reset);
