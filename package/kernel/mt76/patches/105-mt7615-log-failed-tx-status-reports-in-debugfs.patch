 }
 
+/*
+ * Keep the last tx status reports with a timeout, together with the rate
+ * sets of the station as they are when the report comes in and, on MMIO,
+ * the bandwidth and guard interval fields of its WTBL entry.
+ */
+static void mt7615_txs_log_fail(struct mt7615_dev *dev,
+				struct mt7615_sta *sta, __le32 *txs_data)
+{
+	struct mt7615_txs_stats *st = &dev->txs_stats;
+	struct mt7615_txs_fail *f;
+	u32 addr;
+	int i;
+
+	if (!(le32_to_cpu(txs_data[0]) & MT_TXS0_ACK_ERROR_MASK))
+		return;
+
+	f = &st->fail[st->fail_pos++ % ARRAY_SIZE(st->fail)];
+	f->jiffies = jiffies;
+	for (i = 0; i < ARRAY_SIZE(f->txs); i++)
+		f->txs[i] = le32_to_cpu(txs_data[i]);
+	f->rate_set_tsf = READ_ONCE(sta->rate_set_tsf);
+	memcpy(f->rateset, sta->rateset, sizeof(f->rateset));
+
+	f->w5 = 0;
+	f->w27 = 0;
+	if (mt76_is_mmio(&dev->mt76)) {
+		addr = mt7615_mac_wtbl_addr(dev, sta->wcid.idx);
+		f->w5 = mt76_rr(dev, addr + 5 * 4);
+		f->w27 = mt76_rr(dev, addr + 27 * 4);
+	}
+}
+
 static bool mt7615_fill_txs(struct mt7615_dev *dev, struct mt7615_sta *sta,
 			    struct ieee80211_tx_info *info, __le32 *txs_data)
 {
 	mt7615_txs_stats_flags(dev, txs_data);
+	mt7615_txs_log_fail(dev, sta, txs_data);
 	if (__mt7615_fill_txs(dev, sta, info, txs_data))
 		return true;
 
--- a/mt7615/mt7615.h
+++ b/mt7615/mt7615.h
@@ -110,6 +110,17 @@ struct mt7615_wtbl_rate_desc {
 	struct mt7615_sta *sta;
 };
 
+/* a tx status with a timeout, with the rate sets of its station */
+struct mt7615_txs_fail {
+	u32 jiffies;
+	u32 txs[5];
+	u32 rate_set_tsf;
+	u32 w5, w27;
+	struct mt7615_rate_set rateset[2];
+};
+
+#define MT7615_TXS_FAIL_LOG		16
+
 /* counters of the tx status reports, shown in debugfs (txs_stats) */
 struct mt7615_txs_stats {
 	u32 total;
@@ -126,6 +137,10 @@ struct mt7615_txs_stats {
 	u32 bw[4][4];
 	u32 tx_count[32];
 	u32 last_idx[8];
+
+	/* last tx status reports with a timeout, in txs_fail_log */
+	u32 fail_pos;
+	struct mt7615_txs_fail fail[MT7615_TXS_FAIL_LOG];
 };
 
