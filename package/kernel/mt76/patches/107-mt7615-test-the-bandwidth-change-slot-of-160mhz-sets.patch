 	return val & GENMASK(11, 0);
 }
 
+/*
+ * Test override from debugfs for a set sent at 160 MHz: the slot after which
+ * the hardware sends at half the bandwidth (1-7), 0 for none.
+ */
+static u32 mt7615_mac_bw160_change_bw_rate(struct mt7615_dev *dev, u8 bw,
+					   u32 w5)
+{
+	u32 slot = READ_ONCE(dev->bw160_change_bw_rate);
+
+	if (bw != 3 || slot < 1 || slot > 7)
+		return w5;
+
+	w5 &= ~MT_WTBL_W5_CHANGE_BW_RATE;
+	w5 |= FIELD_PREP(MT_WTBL_W5_CHANGE_BW_RATE, slot);
+
+	return w5;
+}
+
 void mt7615_mac_set_rates(struct mt7615_phy *phy, struct mt7615_sta *sta,
 			  struct ieee80211_tx_rate *probe_rate,
 			  struct ieee80211_tx_rate *rates)
@@ -1294,6 +1313,7 @@ void mt7615_mac_set_rates(struct mt7615_
 	      FIELD_PREP(MT_WTBL_W5_CHANGE_BW_RATE,
 			 rd.bw_idx ? rd.bw_idx - 1 : 7) |
 	      rd.sgi;
+	w5 = mt7615_mac_bw160_change_bw_rate(dev, rd.bw, w5);
 
 	mt76_wr(dev, MT_WTBL_RIUCR0, w5);
 
@@ -1496,6 +1516,9 @@ static void mt7615_txs_stats_flags(struc
 	st->total++;
 	st->tx_count[count]++;
 	st->last_idx[FIELD_GET(MT_TXS3_LAST_TX_RATE, txs3)]++;
+	if (!(txs0 & (MT_TXS0_ACK_ERROR_MASK | MT_TXS0_FIXED_RATE)))
+		st->slot_bw[FIELD_GET(MT_TXS3_LAST_TX_RATE, txs3)]
+			   [FIELD_GET(MT_TXS1_BW, txs1)]++;
 	if (!count)
 		st->no_tx++;
 	if (txs0 & MT_TXS0_FIXED_RATE)
