wifi: mt76: mt7615: test the bandwidth change slot of 160 MHz sets

Testing aid, not for merging. MediaTek's driver describes the WTBL DW5
field CHANGE_BW_RATE as "change bw as (fcap/2) if rate_idx > N" and
always sets N to 7, which turns it off. To check what it does on
MT7615, add:

- bw160_change_bw_rate in debugfs: overrides CHANGE_BW_RATE (1-7) for
  rate sets sent at 160 MHz, on MMIO only. 0, the default, leaves it as
  the driver sets it; a new value takes effect at the next rate set
  update.
- bw160_force_tail in debugfs: when set, a set sent at 160 MHz gets the
  robust rate as its third rate even if minstrel's most probable rate is
  a 160 MHz one, so that with a pinned rate that fails, every frame
  reaches slot 4.
- a line in txs_stats that counts acknowledged tx status reports by
  their last slot and the bandwidth they report, so the bandwidth each
  slot was sent at shows directly.

--- a/mt7615/debugfs.c
+++ b/mt7615/debugfs.c
@@ -396,6 +396,13 @@ mt7615_txs_stats_read(struct seq_file *s
 	seq_puts(s, "\nlast_idx:");
 	for (i = 0; i < ARRAY_SIZE(st->last_idx); i++)
 		seq_printf(s, " %d:%u", i, st->last_idx[i]);
+
+	seq_puts(s, "\nslot_bw (acked, slot@MHz):");
+	for (i = 0; i < ARRAY_SIZE(st->slot_bw); i++)
+		for (j = 0; j < ARRAY_SIZE(st->slot_bw[i]); j++)
+			if (st->slot_bw[i][j])
+				seq_printf(s, " %d@%d %u", i, 20 << j,
+					   st->slot_bw[i][j]);
 	seq_puts(s, "\n");
 
 	return 0;
@@ -736,6 +743,10 @@ int mt7615_init_debugfs(struct mt7615_de
 			    &fops_txs_stats_reset);
 	debugfs_create_devm_seqfile(dev->mt76.dev, "txs_fail_log", dir,
 				    mt7615_txs_fail_read);
+	debugfs_create_u32("bw160_change_bw_rate", 0600, dir,
+			   &dev->bw160_change_bw_rate);
+	debugfs_create_u32("bw160_force_tail", 0600, dir,
+			   &dev->bw160_force_tail);
 
 	if (is_mt7615(&dev->mt76)) {
 		debugfs_create_u32("dfs_hw_pattern", 0400, dir,
--- a/mt7615/mac.c
+++ b/mt7615/mac.c
@@ -1123,7 +1123,8 @@ mt7615_mac_update_rate_desc(struct mt761
 		};
 
 		ieee80211_rate_set_vht(&tail, 0, 1);
-		if (!(rates[2].flags & IEEE80211_TX_RC_160_MHZ_WIDTH))
