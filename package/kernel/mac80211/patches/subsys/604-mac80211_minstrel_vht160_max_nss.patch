--- a/net/mac80211/rc80211_minstrel_ht.c
+++ b/net/mac80211/rc80211_minstrel_ht.c
@@ -202,6 +202,15 @@
 		 "Use only VHT rates when VHT is supported by sta.");
 
 /*
+ * Many chips build a 160 MHz channel from two 80 MHz halves and cannot
+ * carry more than two spatial streams on it, even if they advertise more.
+ */
+static int minstrel_vht160_max_nss = 2;
+module_param(minstrel_vht160_max_nss, int, 0644);
+MODULE_PARM_DESC(minstrel_vht160_max_nss,
+		 "Maximum number of spatial streams to use at 160 MHz.");
+
+/*
  * To enable sufficiently targeted rate sampling, MCS rates are divided into
  * groups, based on the number of streams and flags (HT40, SGI) that they
  * use.
@@ -1784,7 +1793,8 @@
 				continue;
 			}
 		} else if (gflags & IEEE80211_TX_RC_160_MHZ_WIDTH) {
-			if (sta->deflink.bandwidth < IEEE80211_STA_RX_BW_160) {
+			if (sta->deflink.bandwidth < IEEE80211_STA_RX_BW_160 ||
+			    nss > minstrel_vht160_max_nss) {
 				continue;
 			}
 		}
