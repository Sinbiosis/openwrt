 MODULE_PARM_DESC(minstrel_vht160_max_nss,
-		 "Maximum number of spatial streams to use at 160 MHz.");
+		 "Maximum number of spatial streams to use with stations operating at 160 MHz (0 disables 160 MHz rates).");
 
