 /*
  * Many chips build a 160 MHz channel from two 80 MHz halves and cannot
  * carry more than two spatial streams on it, even if they advertise more.
+ * Some of them also send a whole rate set (and any probe rate) at the
+ * widest bandwidth in it, so a rate that is fine at 80 MHz can end up on
+ * the air at 160 MHz. For stations operating at 160 MHz the limit is
+ * therefore applied to all bandwidths.
  */
 static int minstrel_vht160_max_nss = 2;
