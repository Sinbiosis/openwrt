mac80211: minstrel_ht: use the peer's VHT Rx MCS map

minstrel_ht picked VHT rates from vht_mcs.tx_mcs_map, which mac80211 fills
with what the peer can transmit (limited by what we can receive). The
rates we may send are the ones the peer can receive, vht_mcs.rx_mcs_map
(limited by what we can transmit), which is also what mac80211's own rate
mask code uses. This only matters with peers whose two maps differ.

--- a/net/mac80211/rc80211_minstrel_ht.c
+++ b/net/mac80211/rc80211_minstrel_ht.c
@@ -1723,7 +1723,7 @@ minstrel_ht_update_caps(void *priv, stru
 	BUILD_BUG_ON(ARRAY_SIZE(minstrel_mcs_groups) != MINSTREL_GROUPS_NB);
 
 	if (vht_cap->vht_supported)
-		use_vht = vht_cap->vht_mcs.tx_mcs_map != cpu_to_le16(~0);
+		use_vht = vht_cap->vht_mcs.rx_mcs_map != cpu_to_le16(~0);
 	else
 		use_vht = 0;
 
@@ -1849,7 +1849,7 @@ minstrel_ht_update_caps(void *priv, stru
 			bw = BW_20;
 
 		mi->supported[i] = minstrel_get_valid_vht_rates(bw, nss,
-				vht_cap->vht_mcs.tx_mcs_map);
+				vht_cap->vht_mcs.rx_mcs_map);
 		if (rx_highest)
 			mi->supported[i] &=
 				minstrel_get_vht_rx_highest_rates(bw, nss,
